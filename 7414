local function getGameStateData()
    local ok, stateMod = pcall(function()
        local client = ReplicatedStorage:FindFirstChild("Client")
        return client and client:FindFirstChild("State") and require(client.State)
    end)
    if ok and stateMod and stateMod.GetData then
        local dataOk, data = pcall(function() return stateMod.GetData() end)
        if dataOk and typeof(data) == "table" then
            return data
        end
    end
    return nil
end

local function extractStateCurrencies(data)
    local cur = {}
    if not data or typeof(data) ~= "table" then return cur end

    local function add(k, v)
        if typeof(v) == "number" then cur[k] = v end
    end

    add("Coins", data.Coins)
    add("Gems", data.Gems)
    add("Snowflakes", data.Snowflakes)
    add("CasinoCoins", data.CasinoCoins)
    add("CasinoTokens", data.CasinoTokens)
    add("Ducats", data.Ducats)
    add("Crystals", data.Crystals)
    add("SukunaFingers", data.SukunaFingers)
    add("Summer", data.Summer)

    if data.Evolutions and typeof(data.Evolutions) == "table" then
        for k, v in pairs(data.Evolutions) do add(k, v) end
    end
    if data.Awakens and typeof(data.Awakens) == "table" then
        for k, v in pairs(data.Awakens) do add(k, v) end
    end
    if data.Stock and typeof(data.Stock) == "table" then
        for k, v in pairs(data.Stock) do add(k, v) end
    end
    if data.DisasterIslands and typeof(data.DisasterIslands) == "table" then
        add("ElementalFragments", data.DisasterIslands.ElementalFragments)
        add("LavaCore", data.DisasterIslands.LavaCore)
        add("AbyssalPearl", data.DisasterIslands.AbyssalPearl)
        add("CursedBloom", data.DisasterIslands.CursedBloom)
    end
    return cur
end

