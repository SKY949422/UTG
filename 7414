-- 6. 巨集核心執行引擎
-- --------------------------------------------------------
runPlayMacro = function(st)
    if isRecording then
        if playCtrl then playCtrl.Set(false) end
        return
    end

    if st then
        if #recordedActions == 0 then
            warn("[Macro 提示] 目前檔案沒有記錄任何動作！請先開啟錄製。")
            if playCtrl then playCtrl.Set(false) end
            return
        end

        task.spawn(function()
            isPlaying = true
            if playCtrl then playCtrl.Set(true) end
            print(string.format("[Macro 重播開始] 正在執行「%s」，共 %d 步 (等錢秒升模式)", currentMacroName, #recordedActions))

            for i, step in ipairs(recordedActions) do
                if not isPlaying or not _G.Suite7414_NewGame_Running then break end
                if playCtrl then
                    playCtrl.SetDesc(string.format("▶ 執行中 (%d/%d 步)...", i, #recordedActions))
                end

                if step.delay > 0 then
                    local targetWait = 0.2
                    if UserConfig.smartFastMode then
                        targetWait = math.clamp(step.delay * 0.1, 0.2, 1.0)
                    else
                        targetWait = step.delay * UserConfig.macroScale
                    end

                    local waited = 0
                    while waited < targetWait and isPlaying and _G.Suite7414_NewGame_Running do
                        task.wait(0.05)
                        waited = waited + 0.05
                    end
                end

                if not isPlaying or not _G.Suite7414_NewGame_Running then break end

                local functionsFolder = ReplicatedStorage:FindFirstChild("Functions")
                if not functionsFolder then break end

                if step.type == "Place" then
                    local spawnFunc = functionsFolder:FindFirstChild("SpawnNewTower")
                    if spawnFunc then
                        while isPlaying and _G.Suite7414_NewGame_Running do
                            local infoFolder = workspace:FindFirstChild("Info")
                            local msg = infoFolder and infoFolder:FindFirstChild("Message") and infoFolder.Message.Value or ""
                            if msg == "VICTORY" or msg == "GAME OVER" then break end

                            local res = false
                            pcall(function()
                                res = spawnFunc:InvokeServer(step.towerId, step.cframe, step.extra)
                            end)

                            local spawnedTower = findNearestTower(step.cframe.Position, 4)
                            if res or spawnedTower then
                                print(string.format("[Macro 成功放塔] (%d/%d)", i, #recordedActions))
                                task.wait(0.5)
                                break
                            end
                            task.wait(0.4)
                        end
                    end

                elseif step.type == "Upgrade" then
                    local upgradeFunc = functionsFolder:FindFirstChild("UpgradeTower")
                    if upgradeFunc then
                        while isPlaying and _G.Suite7414_NewGame_Running do
                            local infoFolder = workspace:FindFirstChild("Info")
                            local msg = infoFolder and infoFolder:FindFirstChild("Message") and infoFolder.Message.Value or ""
                            if msg == "VICTORY" or msg == "GAME OVER" then break end

                            local target = findNearestTower(step.position, 4)
                            if target then
                                local res = nil
                                pcall(function()
                                    res = upgradeFunc:InvokeServer(target)
                                end)
                                
                                if res then
                                    print(string.format("[Macro 成功升級] (%d/%d)", i, #recordedActions))
                                    task.wait(0.6)
                                    break
                                end
                            end
                            task.wait(0.4)
                        end
                    end

                elseif step.type == "Sell" then
                    local sellFunc = functionsFolder:FindFirstChild("SellTower")
                    if sellFunc then
                        local target = findNearestTower(step.position, 4)
                        if target then
                            pcall(function() sellFunc:InvokeServer(target) end)
                            print(string.format("[Macro 成功販賣] (%d/%d)", i, #recordedActions))
                            task.wait(0.4)
                        end
                    end
                end
            end

            task.wait(0.8)
            print("[Macro 重播完成]")
            isPlaying = false
            if playCtrl then
                playCtrl.Set(false)
                playCtrl.SetDesc(string.format("✓ 重播已完成 (共 %d 步)", #recordedActions))
            end
        end)
    else
        isPlaying = false
        if playCtrl then
            playCtrl.Set(false)
            playCtrl.SetDesc(string.format("檔案: %s (共 %d 步動作)", currentMacroName, #recordedActions))
        end
    end
end

