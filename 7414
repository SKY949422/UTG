-- 3. 自動化背景守護線程 (AutoSkip & AutoReplay)
-- --------------------------------------------------------
task.spawn(function()
    task.wait(1.5)
    local hasTriggeredReplay = false

    while _G.Suite7414_NewGame_Running do
        task.wait(1.0)

        -- ★ 精準路徑：自動跳波 (AutoSkip)
        if UserConfig.autoSkip then
            pcall(function()
                local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
                if remotesFolder then
                    local autoSkipEvent = remotesFolder:FindFirstChild("AutoSkip")
                    if autoSkipEvent then
                        autoSkipEvent:FireServer()
                    end
                end
            end)
        end

        -- ★ 自動重開 (Auto Replay)
        if UserConfig.autoReplay then
            pcall(function()
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                local resultsGui = playerGui and (playerGui:FindFirstChild("Results") or playerGui:FindFirstChild("GameOver") or playerGui:FindFirstChild("Summary"))
                
                if (resultsGui and resultsGui.Enabled) and not hasTriggeredReplay then
                    hasTriggeredReplay = true
                    task.wait(1.0)
                    local replayEvent = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("Replay")
                    if replayEvent then
                        print("[Auto Replay] 偵測到結算畫面，自動發送重開！")
                        replayEvent:FireServer()
                    end
                elseif not resultsGui or not resultsGui.Enabled then
                    hasTriggeredReplay = false
                end
            end)
        end
    end
end)

