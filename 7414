local playCtrl
local recordCtrl

runPlayMacro = function(st)
    if isRecording then
        if playCtrl then playCtrl.Set(false) end
        return
    end

    if st then
        if #recordedActions == 0 then
            warn("[Macro 提示] 目前檔案沒有記錄任何動作！請先開啟錄製。")
            if playCtrl then playCtrl.Set(false) end
            return
        end

        task.spawn(function()
            isPlaying = true
            if playCtrl then playCtrl.Set(true) end
            print(string.format("[Macro 重播開始] 正在重播「%s」，共 %d 步...", currentMacroName, #recordedActions))

            for i, step in ipairs(recordedActions) do
                if not isPlaying or not _G.Suite7414_NewGame_Running then break end
                if playCtrl then
                    playCtrl.SetDesc(string.format("▶ 重播中 (%d/%d 步)...", i, #recordedActions))
                end

                if step.delay > 0 then
                    local waited = 0
                    local effectiveDelay = step.delay * UserConfig.macroScale
                    while waited < effectiveDelay and isPlaying and _G.Suite7414_NewGame_Running do
                        task.wait(0.05)
                        waited = waited + 0.05
                    end
                end

                if not isPlaying or not _G.Suite7414_NewGame_Running then break end

                local functionsFolder = ReplicatedStorage:FindFirstChild("Functions")
                if not functionsFolder then break end

                if step.type == "Place" then
                    local spawnFunc = functionsFolder:FindFirstChild("SpawnNewTower")
                    if spawnFunc then
                        for attempt = 1, 10 do
                            if not isPlaying or not _G.Suite7414_NewGame_Running then break end
                            pcall(function()
                                spawnFunc:InvokeServer(step.towerId, step.cframe, step.extra)
                            end)
                            
                            task.wait(0.3)
                            local spawnedTower = findNearestTower(step.cframe.Position, 4)
                            if spawnedTower then
                                print(string.format("[Macro 成功放塔] (%d/%d)", i, #recordedActions))
                                break
                            end
                            task.wait(0.5)
                        end
                    end

                elseif step.type == "Upgrade" then
                    local upgradeFunc = functionsFolder:FindFirstChild("UpgradeTower")
                    if upgradeFunc then
                        local target = findNearestTower(step.position, 4)
                        if target then
                            for attempt = 1, 6 do
                                if not isPlaying or not _G.Suite7414_NewGame_Running then break end
                                pcall(function()
                                    upgradeFunc:InvokeServer(target)
                                end)
                                task.wait(0.3)
                                break
                            end
                            print(string.format("[Macro 成功升級] (%d/%d)", i, #recordedActions))
                        end
                    end

                elseif step.type == "Sell" then
                    local sellFunc = functionsFolder:FindFirstChild("SellTower")
                    if sellFunc then
                        local target = findNearestTower(step.position, 4)
                        if target then
                            pcall(function()
                                sellFunc:InvokeServer(target)
                            end)
                            print(string.format("[Macro 成功販賣] (%d/%d)", i, #recordedActions))
                        end
                    end
                end
            end

            task.wait(0.8)
            print("[Macro 重播完成]")
            isPlaying = false
            if playCtrl then
                playCtrl.Set(false)
                playCtrl.SetDesc(string.format("✓ 重播已完成 (共 %d 步)", #recordedActions))
            end
        end)
    else
        isPlaying = false
        if playCtrl then
            playCtrl.Set(false)
            playCtrl.SetDesc(string.format("檔案: %s (共 %d 步動作)", currentMacroName, #recordedActions))
        end
    end
end

