local function snapshotCurrencies()
    initialCurrencies = {}
    initialStateData = extractStateCurrencies(getGameStateData())

    local function recordVal(name, val)
        local lower = string.lower(name)
        if lower ~= "money" and lower ~= "cash" and lower ~= "wins" and lower ~= "win" then
            if initialCurrencies[name] == nil then
                initialCurrencies[name] = val
            end
        end
    end

    for _, name in ipairs(trackedValues) do
        local obj = LocalPlayer:FindFirstChild(name)
        if obj and obj:IsA("ValueBase") then recordVal(name, obj.Value) end
    end

    local function scan(container)
        if not container then return end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("ValueBase") then
                recordVal(child.Name, child.Value)
            end
        end
    end

    scan(LocalPlayer:FindFirstChild("leaderstats"))
    scan(LocalPlayer:FindFirstChild("Currencies"))
end

local function sendDiscordWebhook(isVictory, wavesBeaten, isTest)
    if not UserConfig.notifyStageFinished or UserConfig.webhookUrl:gsub("%s+", "") == "" then return end

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not httpRequest then return end

    local matchDuration = os.time() - matchStartTime
    local sessionDuration = os.time() - _G.Suite7414_SessionStart
    local mapName = (workspace:FindFirstChild("Info") and workspace.Info:FindFirstChild("Map") and workspace.Info.Map.Value)
        or (workspace:FindFirstChild("Map") and workspace.Map:FindFirstChildOfClass("Model") and workspace.Map:FindFirstChildOfClass("Model").Name)
        or "Beach"

    local currentStateData = extractStateCurrencies(getGameStateData())
    local rewardsList = {}
    local isRareDrop = false
    local processedKeys = {}

    local function addRewardEntry(name, delta, total)
        local lower = string.lower(name)
        if lower == "money" or lower == "cash" or lower == "wins" or lower == "win" then return end
        if processedKeys[name] then return end
        processedKeys[name] = true

        table.insert(rewardsList, string.format("• %s: +%s (%s)", name, tostring(delta), tostring(total)))
        if name == "DroppedFingers" or name:find("Crate") or name:find("Shard") or name:find("Wheel") or name:find("Brain") or name:find("Gem") or name:find("Token") then
            isRareDrop = true
        end
    end

    -- 1. 比對 State 模組中的真實總資產 (Coins, Gems 等)
    for key, currentVal in pairs(currentStateData) do
        local lower = string.lower(key)
        if lower ~= "money" and lower ~= "cash" and lower ~= "wins" and lower ~= "win" then
            local initVal = initialStateData[key] or currentVal
            local stateDelta = currentVal - initVal
            
            local localObj = LocalPlayer:FindFirstChild(key) 
                or (LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild(key))
                or (LocalPlayer:FindFirstChild("Currencies") and LocalPlayer.Currencies:FindFirstChild(key))
            
            local matchDelta = (localObj and localObj:IsA("ValueBase") and typeof(localObj.Value) == "number") and localObj.Value or 0

            if stateDelta > 0 then
                addRewardEntry(key, stateDelta, currentVal)
            elseif matchDelta > 0 then
                local realTotal = initVal + matchDelta
                addRewardEntry(key, matchDelta, realTotal)
            end
        end
    end

    -- 2. 補齊 LocalPlayer 上其他結算掉落項目
    for _, name in ipairs(trackedValues) do
        local lower = string.lower(name)
        if not processedKeys[name] and lower ~= "money" and lower ~= "cash" and lower ~= "wins" and lower ~= "win" then
            local obj = LocalPlayer:FindFirstChild(name) 
                or (LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild(name))
                or (LocalPlayer:FindFirstChild("Currencies") and LocalPlayer.Currencies:FindFirstChild(name))
                
            if obj and obj:IsA("ValueBase") then
                local currentVal = obj.Value
                local initVal = initialCurrencies[name] or currentVal

                if typeof(currentVal) == "number" then
                    local delta = currentVal - initVal
                    if delta > 0 then
                        addRewardEntry(name, delta, currentVal)
                    elseif currentVal > 0 and (initialCurrencies[name] == nil or initialCurrencies[name] == 0) then
                        addRewardEntry(name, currentVal, currentVal)
                    end
                elseif typeof(currentVal) == "string" and currentVal ~= "" and currentVal ~= "None" and currentVal ~= initVal then
                    table.insert(rewardsList, string.format("• %s: +1 (%s)", name, currentVal))
                    processedKeys[name] = true
                    isRareDrop = true
                end
            end
        end
    end

    -- 測試按鈕模擬數據
    if isTest and #rewardsList == 0 then
        local currentCoins = currentStateData.Coins or 550
        local currentGems = currentStateData.Gems or 0
        table.insert(rewardsList, string.format("• Coins: +3000 (%s)", tostring(currentCoins + 3000)))
        table.insert(rewardsList, string.format("• Gems: +300 (%s)", tostring(currentGems + 300)))
    end

    local rewardsText = #rewardsList > 0 and table.concat(rewardsList, "\n") or "• 無 (No Extra Drops)"
    local playerName = UserConfig.webhookHideName and ("||" .. LocalPlayer.Name .. "||") or LocalPlayer.Name

    local statusText = string.format("結果: %s\n地圖: %s\n耗時: %s",
        isVictory and "勝利 (Victory)" or "失敗 (Defeat)",
        mapName,
        formatTime(matchDuration)
    )

    local fieldsList = {
        {
            name = "玩家",
            value = playerName,
            inline = true
        },
        {
            name = "難度",
            value = UserConfig.difficulty or "Hard",
            inline = true
        },
        {
            name = "戰鬥狀態",
            value = statusText,
            inline = false
        },
        {
            name = "獲得獎勵",
            value = rewardsText,
            inline = false
        }
    }

    if UserConfig.notifySessionData then
        table.insert(fieldsList, {
            name = "Session 統計",
            value = string.format("累計時間: %s\n累計場次: %d (勝/負: %d/%d)",
                formatSessionTime(sessionDuration), _G.Suite7414_MatchesPlayed, _G.Suite7414_Wins, _G.Suite7414_Losses),
            inline = false
        })
    end

    local mentionContent = ""
    if UserConfig.mentionId:gsub("%s+", "") ~= "" then
        local rawId = UserConfig.mentionId:gsub("[^%d]", "")
        if rawId ~= "" then
            if not UserConfig.onlyMentionRare or isRareDrop then
                mentionContent = "<@" .. rawId .. ">"
            end
        end
    end

    local embed = {
        title = "Sorcerer Tower Defense 戰報",
        color = isVictory and 16738740 or 15158332,
        fields = fieldsList,
        footer = {
            text = "7414 TD Suite • " .. os.date("%Y/%m/%d %X")
        }
    }

    pcall(function()
        httpRequest({
            Url = UserConfig.webhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                content = mentionContent ~= "" and mentionContent or nil,
                username = "7414 Notifier",
                avatar_url = "https://i.imgur.com/8QpZ5n7.png",
