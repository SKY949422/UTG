        recordedActions = {}
        lastActionTime = os.clock()
        print(string.format("[Macro 開始錄製] 請在遊戲中放塔，將寫入「%s」", currentMacroName))
    else
        saveCurrentMacro()
        print(string.format("[Macro 結束錄製] 已保存 %d 步動作至「%s」", #recordedActions, currentMacroName))
    end
end, 3)

task.spawn(function()
    local lastCount = -1
    local lastState = false
    local lastMacro = ""
    while _G.Suite7414_NewGame_Running do
        task.wait(0.2)
        if #recordedActions ~= lastCount or isRecording ~= lastState or currentMacroName ~= lastMacro then
            lastCount = #recordedActions
            lastState = isRecording
            lastMacro = currentMacroName
            pcall(function()
                if recordCtrl then
                    if isRecording then
                        recordCtrl.SetDesc(string.format("● 錄製中... (已成功捕捉 %d 步動作)", #recordedActions))
                    else
                        recordCtrl.SetDesc("點擊開啟後，在遊戲中放塔與升級")
                    end
                end
                if playCtrl and not isPlaying then
                    playCtrl.SetDesc(string.format("檔案: %s (共 %d 步動作)", currentMacroName, #recordedActions))
                end
            end)
        end
    end
end)

