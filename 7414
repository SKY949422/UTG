                        task.wait(3.0)
                        if not _G.Suite7414_NewGame_Running then return end
                        print(string.format("[Auto Play] 偵測到開局，自動啟動 Macro「%s」", currentMacroName))
                        if runPlayMacro then runPlayMacro(true) end
                    end)
                end
            end
        elseif isGameOver or waveVal == 0 then
            hasAutoPlayedThisMatch = false
        end

        if UserConfig.autoSkip then
            pcall(function()
                local autoSkipVal = LocalPlayer:FindFirstChild("AutoSkip")
                if autoSkipVal and not autoSkipVal.Value then
                    local autoSkipRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("AutoSkip")
                    if autoSkipRemote then autoSkipRemote:FireServer() end
                end

                if skipVisVal then
                    local voteSkipRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("VoteSkip")
                    if voteSkipRemote then voteSkipRemote:FireServer() end
                end
            end)
        end

        if UserConfig.autoReplay then
            local endScreen = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("GameGui") and LocalPlayer.PlayerGui.GameGui:FindFirstChild("EndScreen")
            local isScreenVisible = endScreen and endScreen.Visible

            if (isGameOver or isScreenVisible) and not hasTriggeredReplay then
                hasTriggeredReplay = true
                local isWin = (messageVal == "VICTORY")
                local beaten = (infoFolder and infoFolder:FindFirstChild("WavesBeaten") and infoFolder.WavesBeaten.Value) or waveVal

                _G.Suite7414_MatchesPlayed = _G.Suite7414_MatchesPlayed + 1
                if isWin then
                    _G.Suite7414_Wins = _G.Suite7414_Wins + 1
                else
                    _G.Suite7414_Losses = _G.Suite7414_Losses + 1
                end

                print(string.format("[Auto Replay] 遊戲結束 (%s)，推送 Webhook 戰報！", tostring(messageVal)))
                sendDiscordWebhook(isWin, beaten, false)

                task.spawn(function()
                    for attempt = 1, 8 do
                        if not _G.Suite7414_NewGame_Running then break end

                        pcall(function()
                            local replayEvent = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("Replay")
                            if replayEvent then replayEvent:FireServer() end
                        end)

                        if endScreen and endScreen:FindFirstChild("Replay") then
                            pcall(function()
                                if firesignal then firesignal(endScreen.Replay.Activated) end
                            end)
                        end

                        task.wait(0.8)
                    end
                end)
            elseif not isGameOver and not isScreenVisible then
                hasTriggeredReplay = false
            end
        end
    end
end)

