    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 3
    btn.Parent = sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    if idx == 1 then registerAccent(btn) end
    tab.Button = btn

    btn.MouseButton1Click:Connect(function()
        for _, t in ipairs(navTabs) do
            t.Page.Visible = (t == tab)
            local r, g, b = UserConfig.uiColor:match("(%d+),%s*(%d+),%s*(%d+)")
            local activeColor = (r and g and b) and Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)) or Color3.fromRGB(255, 105, 180)

            if t == tab then
                t.Button.BackgroundColor3 = Color3.fromRGB(22, 26, 33)
                t.Button.TextColor3 = activeColor
                registerAccent(t.Button)
            else
                t.Button.BackgroundColor3 = Color3.fromRGB(11, 13, 17)
                t.Button.TextColor3 = Color3.fromRGB(150, 155, 165)
            end
        end
    end)
end

