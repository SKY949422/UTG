task.spawn(function()
    task.wait(1.5)
    local hasTriggeredReplay = false
    local hasAutoPlayedThisMatch = false
    snapshotCurrencies()

    while _G.Suite7414_NewGame_Running do
        task.wait(0.5)

        local infoFolder = workspace:FindFirstChild("Info")
        local waveVal = infoFolder and infoFolder:FindFirstChild("Wave") and infoFolder.Wave.Value or 0
        local messageVal = infoFolder and infoFolder:FindFirstChild("Message") and infoFolder.Message.Value or ""
        local skipVisVal = infoFolder and infoFolder:FindFirstChild("SkipVis") and infoFolder.SkipVis.Value
        local isGameOver = (messageVal == "VICTORY" or messageVal == "GAME OVER")

        if waveVal >= 1 and not isGameOver then
            if not hasAutoPlayedThisMatch then
                hasAutoPlayedThisMatch = true
                hasTriggeredReplay = false
                matchStartTime = os.time()
                snapshotCurrencies()

                if UserConfig.autoPlayMacro and #recordedActions > 0 and not isPlaying and not isRecording then
