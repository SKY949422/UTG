for i, tab in ipairs(navTabs) do
    local idx = tonumber(i) or 1
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 36)
    btn.Position = UDim2.new(0, 8, 0, 60 + (idx - 1) * 42)
    btn.BackgroundColor3 = (idx == 1) and Color3.fromRGB(22, 26, 33) or Color3.fromRGB(11, 13, 17)
